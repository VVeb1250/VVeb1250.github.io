---
/**
 * @component PageScrollbar
 * @group shell
 * @summary A page scrollbar at the right edge below the header: grey dashed track, context-colored progress, and a deep cyan cursor in light mode or spark cursor in dark mode.
 * @use Once per page — PageShell renders it. Drag or click the track to scroll; wheel, touch and keyboard page scrolling still work.
 * @avoid Placing it beside a visible native scrollbar or inside a section's own scroll area.
 * @behavior The line thickens on hover and focus. The native scrollbar is hidden only after drag is ready, and remains the fallback when custom styling is unavailable or forced colors are active.
 * @example
 * <PageScrollbar cat="game" />
 */
import { langOf, tx } from '../../lib/i18n';
import type { CatOrSelf } from '../../lib/vocab';

export interface Props {
  /** Page context color. The shell passes its own `cat`. */
  cat: CatOrSelf;
}
const { cat } = Astro.props;
const lang = langOf(Astro.url);
const label = tx({ en: 'Page scrollbar', th: 'แถบเลื่อนหน้า', ja: 'ページのスクロールバー' }, lang);
---
<div class="pgscroll" data-cat={cat} role="scrollbar" aria-label={label} aria-controls="main" aria-orientation="vertical" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" tabindex="0" hidden>
  <span class="pgscroll-track" aria-hidden="true"><i></i><span class="pgscroll-cursor"></span></span>
</div>

<style>
  .pgscroll { position: fixed; top: var(--hdr-h); right: 0; bottom: 0; width: 18px; z-index: 39; cursor: ns-resize; touch-action: none; }
  .pgscroll[hidden] { display: none; }
  .pgscroll:focus-visible { outline: none; }
  .pgscroll-track { position: absolute; top: 0; right: 0; bottom: 0; width: 5px; pointer-events: none; transform-origin: right center; transition: transform var(--t-thicken); background: repeating-linear-gradient(180deg, color-mix(in srgb, var(--ink3) 60%, transparent) 0 3px, transparent 3px 6px); }
  .pgscroll-track i { position: absolute; inset: 0; transform-origin: 50% 0; transform: scaleY(0); background: var(--ctxs); will-change: transform; }
  .pgscroll-cursor { position: absolute; top: 0; right: 0; width: 100%; height: 18px; background: var(--scroll-cursor); will-change: transform; }
  .pgscroll:is(:hover, :focus-visible) .pgscroll-track { transform: scaleX(1.4); }
  .pgscroll:active .pgscroll-track { transform: scaleX(1.6); }
  @media (forced-colors: active) { .pgscroll { display: none; } }
</style>

<script>
  import { onPage } from '../../scripts/lifecycle';
  import { onScroll } from '../../scripts/scroll';
  import { scrollToY } from '../../scripts/smooth';

  onPage(() => {
    const rail = document.querySelector<HTMLElement>('.pgscroll');
    if (!rail || !CSS.supports('scrollbar-width', 'none') || matchMedia('(forced-colors: active)').matches) return;
    const fill = rail.querySelector<HTMLElement>('i')!;
    const cursor = rail.querySelector<HTMLElement>('.pgscroll-cursor')!;
    let max = 0;
    let trackTop = 0;
    let trackHeight = 0;
    let cursorTravel = 0;
    let activePointer = -1;
    const update = (y: number) => {
      const p = max ? Math.min(1, Math.max(0, y / max)) : 0;
      fill.style.transform = `scaleY(${p.toFixed(4)})`;
      cursor.style.transform = `translateY(${(p * cursorTravel).toFixed(2)}px)`;
      rail.setAttribute('aria-valuenow', String(Math.round(p * 100)));
    };
    const refresh = () => {
      max = Math.max(0, document.documentElement.scrollHeight - innerHeight);
      rail.hidden = max < 1;
      const r = rail.getBoundingClientRect();
      trackTop = r.top;
      trackHeight = r.height;
      cursorTravel = Math.max(0, trackHeight - cursor.offsetHeight);
      update(window.scrollY);
    };
    const drag = (e: PointerEvent) => {
      scrollToY(max * Math.min(1, Math.max(0, (e.clientY - trackTop) / trackHeight)), true);
    };
    const down = (e: PointerEvent) => {
      if (e.button !== 0 || max < 1) return;
      e.preventDefault();
      activePointer = e.pointerId;
      rail.setPointerCapture(e.pointerId);
      drag(e);
    };
    const move = (e: PointerEvent) => { if (e.pointerId === activePointer) drag(e); };
    const end = (e: PointerEvent) => {
      if (e.pointerId !== activePointer) return;
      activePointer = -1;
      if (rail.hasPointerCapture(e.pointerId)) rail.releasePointerCapture(e.pointerId);
    };
    const keydown = (e: KeyboardEvent) => {
      let y = window.scrollY;
      if (e.key === 'ArrowDown') y += 40;
      else if (e.key === 'ArrowUp') y -= 40;
      else if (e.key === 'PageDown') y += innerHeight * 0.9;
      else if (e.key === 'PageUp') y -= innerHeight * 0.9;
      else if (e.key === 'Home') y = 0;
      else if (e.key === 'End') y = max;
      else return;
      e.preventDefault();
      scrollToY(Math.min(max, Math.max(0, y)));
    };

    document.documentElement.classList.add('page-scrollbar-ready');
    const ro = new ResizeObserver(refresh);
    ro.observe(document.body);
    ro.observe(rail);
    addEventListener('resize', refresh, { passive: true });
    rail.addEventListener('pointerdown', down);
    rail.addEventListener('pointermove', move);
    rail.addEventListener('pointerup', end);
    rail.addEventListener('pointercancel', end);
    rail.addEventListener('keydown', keydown);
    const off = onScroll(update);
    refresh();
    return () => {
      off();
      ro.disconnect();
      removeEventListener('resize', refresh);
      rail.removeEventListener('pointerdown', down);
      rail.removeEventListener('pointermove', move);
      rail.removeEventListener('pointerup', end);
      rail.removeEventListener('pointercancel', end);
      rail.removeEventListener('keydown', keydown);
      document.documentElement.classList.remove('page-scrollbar-ready');
    };
  });
</script>

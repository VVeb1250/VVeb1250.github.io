---
/**
 * @component HomeCover
 * @group home
 * @summary The first screen of Home: the name, very large, and under it the plain facts a hiring reader looks for — what he studies, the internship he wants (and when he is free), how to reach him — then two ways on: the selected work below, or all of it.
 * @use Top of Home only, once. Values come from src/lib/site.ts (name, email, GitHub, availability, the CV file) and the props; the `available` / `cv` slots add anything else under those two facts.
 * @avoid A tagline, slogan or manifesto (Story §0.3); adjective lists; a second giant name anywhere else; hiding the facts behind a hover or a scroll.
 * @behavior The two name lines rise into place one after the other on load (transform + opacity, once), then his nickname writes itself in, raised after the surname, in his own hand between quotes (Signature, identity blue); the facts follow. Reduced motion: everything is simply there. The email copies with one press (CopyText).
 * @example
 * <HomeCover study={{ en: 'Computer Engineering (CoE)' }} school={{ en: 'Khon Kaen University · year 3 · expected 2028' }} looking={{ en: 'An AI engineering internship.' }} workCount={8} />
 */
import CopyText from '../primitives/CopyText.astro';
import ExternalLink from '../primitives/ExternalLink.astro';
import GoLink from '../primitives/GoLink.astro';
import Signature from '../primitives/Signature.astro';
import { SITE } from '../../lib/site';
import { langOf, tx, href, type L } from '../../lib/i18n';
export interface Props {
  study: L;
  school: L;
  looking: L;
  /** How many works the Work page shows. */
  workCount: number;
  /** How many Selected work blocks follow on Home. */
  featured?: number;
}
const { study, school, looking, workCount, featured = 3 } = Astro.props;
const lang = langOf(Astro.url);
const [first, ...rest] = tx(SITE.name, lang).split(/[ ・]/);
const gh = SITE.links.find((l) => l.kind === 'github');
const p2 = (n: number) => String(n).padStart(2, '0');
const cv = SITE.cv ? `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}${SITE.cv}` : null;
---
<header class="hc" data-mark={tx({ en: 'Home', th: 'หน้าแรก', ja: 'ホーム' }, lang)}>
  <h1 class="hc-name disp" data-mark-trigger>
    <span class="hc-l" data-reveal style="--i:0">{first}</span>
    <span class="hc-l" data-reveal style="--i:2">{rest.join(' ')}<Signature name="web-quoted" label={`“${SITE.handle}”`} write delay={650} class="hc-sig" /></span>
  </h1>
  <dl class="hc-facts">
    <div class="hc-f" data-reveal style="--i:5">
      <dt class="eyebrow l10n">{tx({ en: 'Study', th: 'เรียน', ja: '専攻' }, lang)}</dt>
      <dd><b>{tx(study, lang)}</b><span>{tx(school, lang)}</span></dd>
    </div>
    <div class="hc-f" data-reveal style="--i:6">
      <dt class="eyebrow l10n">{tx({ en: 'Looking for', th: 'กำลังหา', ja: '募集' }, lang)}</dt>
      <dd><b>{tx(looking, lang)}</b><span class="hc-av">{tx(SITE.available, lang)}</span><slot name="available" /></dd>
    </div>
    <div class="hc-f" data-reveal style="--i:7">
      <dt class="eyebrow l10n">{tx({ en: 'Contact', th: 'ติดต่อ', ja: '連絡先' }, lang)}</dt>
      <dd>
        <span class="hc-mail"><CopyText text={SITE.email} /></span>
        {gh && <ExternalLink href={gh.url} bare>{gh.note}</ExternalLink>}
        {cv && <a class="hc-cv" href={cv} download><span>CV</span><span class="num">PDF</span><span aria-hidden="true">↓</span></a>}
        <slot name="cv" />
      </dd>
    </div>
  </dl>
  <nav class="hc-go" data-reveal style="--i:8" aria-label={tx({ en: 'Where to go', th: 'ไปต่อ', ja: '次へ' }, lang)}>
    <a href="#work"><span>{tx({ en: 'Selected work', th: 'ผลงานที่เลือก', ja: '選んだ作品' }, lang)}</span><span class="num">[{p2(featured)}]</span><span aria-hidden="true">↓</span></a>
    <a href={href('/work/', lang)}><span>{tx({ en: 'All work', th: 'ผลงานทั้งหมด', ja: 'すべての作品' }, lang)}</span><span class="num">[{p2(workCount)}]</span><GoLink lineOnly /></a>
  </nav>
</header>

<style>
  .hc { padding-block: clamp(36px, 6vw, 80px) clamp(40px, 6vw, 88px); display: grid; gap: clamp(28px, 4vw, 56px); min-height: calc(100svh - var(--hdr-h)); align-content: end; }
  .hc-name { display: grid; font-size: clamp(64px, 13.6vw, 212px); line-height: 0.84; letter-spacing: -0.025em; }
  :global(:root[lang='th']) .hc-name { line-height: 1.05; font-size: clamp(52px, 11vw, 176px); }
  :global(:root[lang='ja']) .hc-name { line-height: 1.1; font-size: clamp(44px, 9.4vw, 150px); }
  .hc-l { display: block; }
  .hc-l + .hc-l { padding-left: clamp(0px, 9vw, 150px); }
  /* his nickname, in his own hand between quotes, raised after the surname (where the typed “Web” used to sit) */
  /* raised with `top`, not `vertical-align`: a raised inline box stretches its line, and a dragged selection paints the whole
     line box (it covered the first name's letters above) */
  .hc-l :global(.hc-sig) { font-size: 0.4em; margin-left: 0.22em; vertical-align: baseline; position: relative; top: -1.05em; }
  .hc-facts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--ink); }
  .hc-f { display: grid; gap: 10px; align-content: start; padding: 16px clamp(16px, 2vw, 28px) 0 0; }
  .hc-f + .hc-f { padding-left: clamp(16px, 2vw, 28px); border-left: 1px solid var(--rule); }
  .hc-f dd { margin: 0; display: grid; gap: 6px; justify-items: start; font-size: 16px; }
  .hc-f dd b { font-weight: 600; font-size: clamp(17px, 1.5vw, 21px); line-height: 1.3; }
  .hc-f dd > span { color: var(--ink2); }
  .hc-av { font-size: 15px; max-width: 34ch; }
  .hc-cv { display: inline-flex; gap: 8px; align-items: baseline; color: var(--ink); text-decoration: none; border-bottom: 1px solid var(--rule); padding-bottom: 2px; transition: border-color var(--t-cursor); }
  .hc-cv .num { font: 500 11px/1 var(--f-mono); color: var(--ink2); }
  .hc-cv span:last-child { font: 500 12px/1 var(--f-mono); color: var(--ink2); transition: transform var(--t-cursor) var(--e-enter); }
  .hc-cv:hover { border-color: var(--acc); }
  .hc-cv:hover span:last-child { transform: translateY(2px); color: var(--acc); }
  .hc-mail { display: inline-flex; gap: 10px; align-items: center; flex-wrap: wrap; }
  .hc-mail :global(.copy) { font-size: 15px; }
  .hc-mail :global(.copy-v) { color: var(--ink); }
  .hc-go { display: flex; flex-wrap: wrap; gap: 12px 40px; }
  .hc-go a { display: inline-flex; gap: 10px; align-items: baseline; text-decoration: none; color: inherit; font-family: var(--f-disp); font-stretch: var(--disp-stretch); font-weight: 600; font-size: clamp(22px, 2.2vw, 30px); }
  .hc-go .num { font: 500 12px/1 var(--f-mono); color: var(--ink3); }
  .hc-go a:hover span:first-child { text-decoration: underline; text-decoration-color: var(--acc); text-decoration-thickness: 2px; text-underline-offset: 0.18em; }
  @media (max-width: 820px) {
    .hc { min-height: 0; }
    .hc-facts { grid-template-columns: minmax(0, 1fr); }
    .hc-f + .hc-f { padding-left: 0; border-left: 0; border-top: 1px solid var(--rule); padding-top: 14px; margin-top: 14px; }
    .hc-l + .hc-l { padding-left: 0; }
  }
</style>

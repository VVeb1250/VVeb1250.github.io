---
/**
 * @component VajaFeature
 * @group home
 * @summary Journey of Vaja on Home: the original crystal-staff source art is the main object, traced into its own resting glyph. The title and contribution lead; a real build frame and the exported run cycle sit separately below (and the attribution, where the page asks for it).
 * @use Home → Selected work, first. The source-art object shows a concrete piece of the owner's contribution; the recorded build and exported animation show it in the game.
 * @avoid Turning this into a template for other works; presenting a source-art cutout as gameplay; overlaying text on the art; running the object under the selection bar.
 * @behavior Hosted SketchReveal opens the source art on hover or keyboard focus; leaving closes it. Touch opens in the middle screen band. The owner-approved wide Plate grounds the transparent staff. FrameStepper plays or steps the real run cycle with its own controls and stops offscreen; reduced motion retains manual stepping. The project block opens the work; the evidence row is separate. Under 820px text stacks; under 600px evidence stacks.
 * @example
 * <VajaFeature />
 */
import { Image } from 'astro:assets';
import MetaLine from '../primitives/MetaLine.astro';
import GoLink from '../primitives/GoLink.astro';
import SketchReveal from '../media/SketchReveal.astro';
import FrameStepper from '../media/FrameStepper.astro';
import AttributionBlock from '../blocks/AttributionBlock.astro';
import { langOf, tx, type L } from '../../lib/i18n';
import { img, lqStyle } from '../../lib/media';
import { work, workHref, vtLabel, ctxOf } from '../../lib/works';
export interface Props {
  /** Original transparent source art. Default: the crystal staff from the game project. */
  art?: string;
  artAlt?: L;
  /** Optional manual glyph; otherwise trace the source art at 16 cells across. */
  glyph?: string[];
  /** Short facts line. Default: the work's `fact`. */
  facts?: L[];
  /** Who else made the game (Facts: concept, effects, some skill art). */
  credit?: L;
  /** What the scene is, under it. */
  note?: L;
  /** Evidence told beside the project: a frame from the build, and an exported animation strip (frames laid out left → right). */
  frame?: { src: string; alt: L; caption: L };
  run?: { src: string; frames: number; fps: number; caption: L };
  /** Show who did what under the evidence row. Home leaves it out (the work page carries the full credit, Story §0.3). Default true. */
  attribution?: boolean;
  base?: string;
}
const {
  art = 'vaja/crystal-staff-source.png',
  artAlt = { en: 'The crystal staff: wooden shaft with a blue crystal, from the original game source art', th: 'ไม้เท้าคริสตัล: ด้ามไม้ มีคริสตัลสีน้ำเงิน จาก art ต้นฉบับของเกม', ja: '水晶の杖：青い水晶のついた木の柄。ゲームの原画から。' },
  glyph,
  facts,
  credit = { en: 'The concept and story came mainly from a teammate; teammates also made the effects and some of the skill art.', th: 'ไอเดียกับเรื่องมาจากเพื่อนร่วมทีมเป็นหลัก เพื่อนร่วมทีมยังทำ effect และ art ของ skill บางส่วนด้วย', ja: '主なコンセプトとストーリーは、主にチームメイトが担当しました。エフェクトや一部のスキルのアートもチームメイトが制作しました。' },
  note = { en: 'Crystal staff · original game source art', th: 'ไม้เท้าคริสตัล · art ต้นฉบับของเกม', ja: '水晶の杖 · ゲームの原画' },
  frame = { src: 'vaja/scene-celestia-grounded.webp', alt: { en: 'Gameplay frame: Vaja standing on the ground in the crystal cavern', th: 'เฟรมจากเกม: Vaja ยืนอยู่บนพื้นในถ้ำคริสตัล', ja: 'ゲーム画面：水晶の洞窟の地面に立つVaja' }, caption: { en: 'In the build · Celestia Crystal Cavern, a frame from the recorded build', th: 'ในตัวเกม · Celestia Crystal Cavern เฟรมจาก build ที่บันทึกไว้', ja: 'ゲーム内 · Celestia Crystal Cavern、録画したビルドのフレーム' } },
  run = { src: 'vaja/strip-run.webp', frames: 8, fps: 12, caption: { en: 'Run cycle · 8 frames from the rig, exported at 12 fps', th: 'Run cycle · 8 เฟรมจาก rig ส่งออกที่ 12 fps', ja: 'Run cycle · リグから書き出した8フレーム、12 fps' } },
  attribution = true,
  base
} = Astro.props;
const lang = langOf(Astro.url);
const w = await work('vaja');
const d = w.data;
const href = d.page ? workHref('vaja', lang, base) : undefined;
const line = facts ?? (d.fact ? [d.fact] : []);
const vt = { 'data-vt': 'deeper', 'data-vt-cat': ctxOf(w), 'data-vt-label': vtLabel(w), 'data-work': 'vaja' };
const fm = frame ? img(frame.src) : null;
const flq = fm ? await lqStyle(fm) : '';
---
<div class="vf" data-feature data-skr-host data-go data-work="vaja" data-cat={ctxOf(w)}>
  <div class="vf-pj" data-pj>
    <div class="vf-art">
      <SketchReveal host plate="wide" glyph={glyph} glyphFrom={glyph ? undefined : art} glyphCols={16} glyphScale={0.44} ratio="6 / 2" size="fill" realWidth={0.96} index="01" tag={{ en: 'SOURCE ART', th: 'ART ต้นฉบับ', ja: '原画' }}
        real={{ src: art, alt: artAlt }} />
      {note && <p class="vf-note">{tx(note, lang)}</p>}
    </div>
    <div class="vf-txt">
      <span class="eyebrow">{d.type} · {d.year}</span>
      <h2 class="disp" data-vt-title>{href ? <a href={href} {...vt}>{d.title}</a> : d.title}</h2>
      {line.length > 0 && <MetaLine items={line} tone="ink" />}
      <p class="vf-line">{tx(d.line, lang)}</p>
      {href && <a class="vf-go" href={href} data-skr-go {...vt}><GoLink /></a>}
    </div>
  </div>
  {(fm || run) && (
    <div class="vf-more">
      {fm && frame && (
        <figure class="vf-frame">
          <Image style={flq} data-lq src={fm} alt={tx(frame.alt, lang)} widths={[480, 720].filter((x) => x <= fm.width)} sizes="(max-width: 820px) 60vw, 300px" loading="lazy" />
          <figcaption>{tx(frame.caption, lang)}</figcaption>
        </figure>
      )}
      {run && (
        <figure class="vf-run">
          <FrameStepper strips={[{ src: run.src, frames: run.frames, fps: run.fps, name: 'Vaja · run' }]} />
          <figcaption>{tx(run.caption, lang)}</figcaption>
        </figure>
      )}
      {attribution && <div class="vf-attribution">
        <AttributionBlock rows={[
          { who: 'me', did: { en: 'Project head. Most of the main art, scene composition, rigging and animation, and player control.', th: 'ในฐานะหัวหน้าโปรเจกต์ ผมวาด art หลักส่วนใหญ่ จัดองค์ประกอบฉาก ทำ rigging กับ animation และระบบควบคุมผู้เล่น', ja: 'プロジェクトリーダー。メインのアートの大半、シーン構成、リギングとアニメーション、プレイヤー操作。' } },
          ...(credit ? [{ who: 'team' as const, did: credit }] : []),
          { who: { en: 'External assets', th: 'Asset ภายนอก', ja: '外部のアセット' }, did: { en: 'Some assets came from outside the team.', th: 'Asset บางส่วนมาจากภายนอกทีม', ja: '一部のアセットはチーム外から提供されました。' } }
        ]} />
      </div>}
    </div>
  )}
</div>

<style>
  .vf { display: grid; gap: clamp(18px, 2.4vw, 28px); }
  .vf-pj { display: flex; flex-direction: column; gap: clamp(24px, 3vw, 40px); }
  /* The wide Plate grounds the transparent staff without extending under the selection bar. */
  .vf-art { order: 2; width: 100%; display: grid; gap: 10px; }
  .vf-art :global(.skr) { max-width: 1060px; margin-inline: auto; }
  .vf-note { font: 500 11px/1.45 var(--f-mono); color: var(--ink3); }
  .vf-txt { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 14px clamp(28px, 7vw, 96px); justify-items: start; width: 100%; }
  .vf-txt > .eyebrow { grid-column: 1; grid-row: 1; }
  h2 { grid-column: 1; grid-row: 2; font-size: clamp(38px, 5.4vw, 72px); line-height: 1.02; max-width: 14ch; }
  .vf-txt :global(.ml) { grid-column: 2; grid-row: 1; }
  .vf-line { grid-column: 2; grid-row: 2 / span 2; font-size: clamp(18px, 1.6vw, 21px); }
  .vf-go { grid-column: 1; grid-row: 3; }
  h2 a { color: inherit; text-decoration: none; }
  h2 a:hover { text-decoration: underline; text-decoration-color: var(--ctxs); text-underline-offset: 0.1em; }
  .vf-line { color: var(--ink2); max-width: 36ch; }
  .vf-credit { font-size: 14px; color: var(--ink2); max-width: 36ch; padding-top: 8px; border-top: 1px solid var(--rule); }
  .vf-go { text-decoration: none; color: inherit; }
  /* the evidence row sits under the scene, small: the build it came from, and the rig in motion */
  .vf-more { display: grid; grid-template-columns: minmax(0, 1fr) minmax(200px, 0.85fr) minmax(0, 1.35fr); align-items: start; gap: clamp(20px, 4vw, 56px); padding-top: 24px; border-top: 1px solid var(--rule); }
  .vf-more figure { margin: 0; display: grid; gap: 6px; }
  .vf-more figcaption { font: 500 11px/1.45 var(--f-mono); color: var(--ink3); max-width: 34ch; }
  .vf-frame :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; border: 1px solid var(--rule); }
  @media (max-width: 820px) {
    .vf-txt { grid-template-columns: minmax(0, 1fr); }
    .vf-txt > .eyebrow, h2, .vf-txt :global(.ml), .vf-line, .vf-go { grid-column: 1; grid-row: auto; }
    .vf-more { max-width: none; }
    .vf-more { grid-template-columns: minmax(0, 1fr) minmax(200px, 1fr); }
    .vf-attribution { grid-column: 1 / -1; }
  }
  @media (max-width: 600px) { .vf-more { grid-template-columns: minmax(0, 1fr); } }
</style>

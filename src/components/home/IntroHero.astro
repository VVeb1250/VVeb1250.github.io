---
/**
 * @component IntroHero
 * @group home
 * @summary (Home now opens with HomeCover; kept for the kit.) The home introduction: the owner's name or statement leads, with a supporting line beside study, year, direction and internship availability. Put a NowBar inside.
 * @use Top of the home page only. One per site.
 * @avoid A second giant statement anywhere else; slogans about "passion"; emoji; self-describing adjective lists in `traits` (the work shows them) unless the owner picks them.
 * @example
 * <IntroHero statement='Teethawat “Web” Kumying' who={{ en: 'Computer Engineering (CoE), Khon Kaen University · year 3' }}>
 *   <NowBar items={[…]} />
 * </IntroHero>
 */
import { langOf, tx, type L } from '../../lib/i18n';
export interface Props {
  statement: L;
  sub?: L;
  /** Who and where, as plain metadata: name, study, year, direction (one line, facts only). */
  who?: L;
  traits?: L;
}
const { statement, sub, who, traits } = Astro.props;
const lang = langOf(Astro.url);
---
<header class="intro">
  <h1 class="statement disp">{tx(statement, lang)}</h1>
  {sub && <p class="sub">{tx(sub, lang)}</p>}
  {who && <p class="who">{tx(who, lang)}</p>}
  {traits && <p class="traits">{tx(traits, lang)}</p>}
  <div><slot /></div>
</header>

<style>
  .intro { padding-block: clamp(44px, 7vw, 92px) 24px; display: grid; grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr); column-gap: clamp(28px, 6vw, 80px); row-gap: 20px; align-items: start; }
  .statement { grid-column: 1; grid-row: 1; font-size: clamp(40px, 5.8vw, 78px); line-height: 1.04; text-wrap: balance; }
  :global(:root[lang='th']) .statement { line-height: 1.2; }
  :global(:root[lang='ja']) .statement { line-height: 1.25; font-size: clamp(34px, 5.6vw, 72px); }
  .sub { grid-column: 1; grid-row: 2; font-size: clamp(20px, 2vw, 26px); color: var(--ink2); max-width: 42ch; }
  .who { grid-column: 2; grid-row: 1; font-size: 16px; line-height: 1.6; max-width: 42ch; padding-top: 14px; border-top: 1px solid var(--rule); }
  .intro > div { grid-column: 2; grid-row: 2; }
  .traits { font: 500 13px/1.6 var(--f-mono); letter-spacing: 0.04em; color: var(--ink2); }
  :global(:root[lang='th']) .traits, :global(:root[lang='ja']) .traits { font: 500 14px/1.6 var(--f-body); }
  @media (max-width: 820px) { .intro { grid-template-columns: minmax(0, 1fr); } .statement, .sub, .who, .intro > div { grid-column: 1; grid-row: auto; } }
</style>

---
/**
 * @component ArchiveRow
 * @group lists
 * @summary One work as a row: year · title + why it matters · kind · status · where it goes. Opens the work page if there is one (the row ends in GoLink's line), else the first evidence link (↗).
 * @use Inside ArchiveList or RelatedWork (they render the list element). Data from the work's YAML.
 * @avoid Rows for low-signal work (leave it out of the archive entirely).
 * @behavior Optional object column shows only the work's static Pictogram. Hover and keyboard focus highlight the row; no image or sketch opens. The Archive page keeps the year in its own column, aligned at the bottom. Without an object it retains the compact text-row layout.
 * @example
 * <ul class="rows"><ArchiveRow work="yasm" /></ul>
 */
import CategoryTick from '../primitives/CategoryTick.astro';
import StatusTag from '../primitives/StatusTag.astro';
import WorkObject from '../media/WorkObject.astro';
import GoLink from '../primitives/GoLink.astro';
import { langOf, tx } from '../../lib/i18n';
import { work, workHref, vtLabel, baseOf, ctxOf } from '../../lib/works';
export interface Props {
  work: string;
  base?: string;
  /** Hide the kind column (when the list is already about one kind). */
  noKind?: boolean;
  /** Add the work's static glyph column, for the Archive page. */
  object?: boolean;
}
const { work: id, base, noKind = false, object = false } = Astro.props;
const lang = langOf(Astro.url);
const w = await work(id);
const d = w.data;
const page = d.page ? workHref(id, lang, base ?? baseOf(w)) : undefined;
const ext = !page && d.links[0] ? d.links[0].url : undefined;
const href = page ?? ext;
---
<li class:list={['ar', { 'has-object': object }]} id={id} data-cat={d.cat} data-work={id} data-tags={d.tags.join(' ')} data-status={d.status ?? ''}>
  <a class="ar-in" href={href} data-vt={page ? 'deeper' : undefined} data-vt-cat={ctxOf(w)} data-vt-label={vtLabel(w)} data-work={page ? id : undefined} tabindex={href ? undefined : -1} aria-disabled={href ? undefined : 'true'}>
    {object && <span class="ar-object"><WorkObject work={id} glyphOnly /></span>}
    <span class="ar-y num">{d.year}</span>
    <span class="ar-t"><b class="disp" data-vt-title>{d.title}</b><span>{tx(d.line, lang)}</span></span>
    {!noKind && <span class="ar-c"><CategoryTick cat={d.cat} kind={d.kind} /></span>}
    <span class="ar-s">{d.status && <StatusTag status={d.status} />}</span>
    <span class="ar-go" aria-hidden="true">{page ? <GoLink lineOnly /> : ext ? '↗' : ''}</span>
  </a>
</li>

<style is:global>
  .rows { list-style: none; margin: 0; padding: 0; }
  .ar { border-top: 1px solid var(--rule); }
  .ar:last-child { border-bottom: 1px solid var(--rule); }
  .ar[hidden] { display: none; }
  .ar-in { display: grid; grid-template-columns: 64px minmax(0, 1fr) 210px 120px 56px; gap: 8px 20px; align-items: center; padding: 16px 12px; color: inherit; text-decoration: none; transition: background-color var(--t-cursor) var(--e-enter), box-shadow var(--t-cursor) var(--e-enter); }
  .ar-in:not([href]) { cursor: default; }
  .ar-in[href]:hover, .ar-in[href]:focus-visible, .ar.is-locked .ar-in { background: color-mix(in srgb, var(--surface) 80%, transparent); box-shadow: inset 3px 0 0 var(--ctxs); outline: none; }
  .ar-y { font: 500 13px/1 var(--f-mono); color: var(--ink2); }
  .ar-t { display: grid; gap: 2px; }
  .ar-t b { font-size: 20px; line-height: 1.2; }
  .ar-t span { font-size: 14px; color: var(--ink2); }
  .ar-go { font: 500 16px/1 var(--f-mono); color: var(--ink2); display: flex; justify-content: flex-end; }
  @media (max-width: 760px) { .ar-in { grid-template-columns: 44px minmax(0, 1fr) auto; } .ar-c, .ar-go { display: none; } }
</style>

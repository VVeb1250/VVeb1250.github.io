---
/**
 * @component TimelineRow
 * @group lists
 * @summary One entry on the Timeline: month · title + its line · kind · status, and where it goes. An entry with a page (a work, or a competition / teaching page) is a link that ends in GoLink's line; an entry that `opens` part of another page links there; every other entry opens in place to show its type, when, team / solo, the extra `more` text and its links.
 * @use Inside TimelineList (it renders the year groups and the list element). Data from the entry's YAML (src/content/works/<id>.yaml).
 * @avoid A row that does nothing; repeating the line inside its own opened panel; thumbnails.
 * @behavior Hover and keyboard focus highlight the row (a plate and a bar in the entry's color). An in-place row is a <details>: the plus at its end turns into a cross and the panel grows open (instant with reduced motion, or where the browser cannot animate to auto height).
 * @example
 * <ol class="tl-rows"><TimelineRow work="icpc" /><TimelineRow work="mg" /></ol>
 */
import CategoryTick from '../primitives/CategoryTick.astro';
import StatusTag from '../primitives/StatusTag.astro';
import GoLink from '../primitives/GoLink.astro';
import ExternalLink from '../primitives/ExternalLink.astro';
import MetaList from '../primitives/MetaList.astro';
import { langOf, tx, type L } from '../../lib/i18n';
import { work, entryHref, when, vtLabel, metaLabel, ctxOf } from '../../lib/works';
export interface Props {
  work: string;
}
const { work: id } = Astro.props;
const lang = langOf(Astro.url);
const w = await work(id);
const d = w.data;
const go = entryHref(w, lang);
const t = when(w);
const loc = { en: 'en-US', th: 'th-TH', ja: 'ja-JP' }[lang];
const month = t.m ? new Intl.DateTimeFormat(loc, { month: 'short', timeZone: 'UTC' }).format(new Date(Date.UTC(t.y, t.m - 1, 1))) : null;
const deeper = d.page ? { 'data-vt': 'deeper', 'data-vt-cat': ctxOf(w), 'data-vt-label': vtLabel(w), 'data-work': id } : {};
// the opened panel: what the row does not already say
const how: L | null = d.tags.includes('solo') ? { en: 'Solo', th: 'ทำคนเดียว', ja: '個人' } : d.tags.includes('team') ? { en: 'Team', th: 'ทีม', ja: 'チーム' } : null;
const facts = [
  { k: tx({ en: 'Type', th: 'ประเภท', ja: '種類' }, lang), v: d.type },
  { k: tx({ en: 'When', th: 'ช่วงเวลา', ja: '時期' }, lang), v: month ? `${month} ${t.y}` : String(t.y) },
  ...(how ? [{ k: tx({ en: 'Who', th: 'ใคร', ja: '体制' }, lang), v: tx(how, lang) }] : []),
  ...(d.tags.includes('coursework') && !/COURSEWORK/i.test(d.type) ? [{ k: tx({ en: 'For', th: 'สำหรับ', ja: '用途' }, lang), v: tx({ en: 'Coursework', th: 'งานวิชา', ja: '授業' }, lang) }] : []),
  ...d.meta.map((m) => ({ k: metaLabel(m.k, lang), v: tx(m.v, lang) }))
];
---
<li class="tr" id={id} data-cat={d.cat} data-kind={d.kind} data-work={id} data-tags={d.tags.join(' ')} data-status={d.status ?? ''}>
  {go ? (
    <a class="tr-in" href={go} {...deeper}>
      <span class="tr-m num">{month ?? '—'}</span>
      <span class="tr-t"><b class="disp" data-vt-title={d.page ? '' : undefined}>{d.title}</b><span>{tx(d.line, lang)}</span>{d.fact && <span class="tr-f">{tx(d.fact, lang)}</span>}</span>
      <span class="tr-c"><CategoryTick cat={d.cat} kind={d.kind} /></span>
      <span class="tr-s">{d.status && <StatusTag status={d.status} />}</span>
      <span class="tr-go" aria-hidden="true"><GoLink lineOnly /></span>
    </a>
  ) : (
    <details class="tr-x">
      <summary class="tr-in">
        <span class="tr-m num">{month ?? '—'}</span>
        <span class="tr-t"><b class="disp">{d.title}</b><span>{tx(d.line, lang)}</span>{d.fact && <span class="tr-f">{tx(d.fact, lang)}</span>}</span>
        <span class="tr-c"><CategoryTick cat={d.cat} kind={d.kind} /></span>
        <span class="tr-s">{d.status && <StatusTag status={d.status} />}</span>
        <span class="tr-go" aria-hidden="true"><i class="tr-plus"><b></b><b></b></i></span>
      </summary>
      <div class="tr-more">
        <div class="tr-more-in">
          {d.more && <p class="tr-p">{tx(d.more, lang)}</p>}
          <MetaList items={facts} />
          {d.links.length > 0 && <span class="tr-links">{d.links.map((l) => <ExternalLink href={l.url} bare>{l.label}</ExternalLink>)}</span>}
        </div>
      </div>
    </details>
  )}
</li>

<style is:global>
  .tr { border-top: 1px solid var(--rule); list-style: none; }
  .tr:last-child { border-bottom: 1px solid var(--rule); }
  .tr[hidden] { display: none; }
  .tr-in { display: grid; grid-template-columns: 52px minmax(0, 1fr) 180px 104px 52px; gap: 6px 20px; align-items: baseline; padding: 16px 12px 16px 10px;
    color: inherit; text-decoration: none; cursor: pointer; list-style: none; position: relative;
    transition: background-color var(--t-cursor) var(--e-enter), box-shadow var(--t-cursor) var(--e-enter); }
  .tr-in::-webkit-details-marker { display: none; }
  .tr-in:hover, .tr-in:focus-visible, .tr-x[open] > .tr-in { background: color-mix(in srgb, var(--surface) 80%, transparent); box-shadow: inset 3px 0 0 var(--ctxs); outline: none; }
  .tr-in:focus-visible { box-shadow: inset 3px 0 0 var(--ctxs), 0 0 0 2px var(--ctxs); }
  .tr-m { font: 500 12px/1 var(--f-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink2); }
  :root[lang='th'] .tr-m, :root[lang='ja'] .tr-m { font: 500 13px/1 var(--f-body); letter-spacing: 0; }
  .tr-t { display: grid; gap: 4px; }
  .tr-t b { font-size: clamp(20px, 1.8vw, 24px); line-height: 1.15; }
  .tr-t > span { font-size: 15px; color: var(--ink2); max-width: 62ch; text-wrap: pretty; }
  .tr-t > .tr-f { font: 500 12px/1.4 var(--f-mono); letter-spacing: 0.04em; color: var(--ctxs); }
  .tr-c, .tr-s { align-self: center; }
  .tr-go { align-self: center; display: flex; justify-content: flex-end; }
  /* the plus: two strokes in the entry's color; open, they turn into a cross */
  .tr-plus { position: relative; width: 14px; height: 14px; display: block; transition: transform var(--t-cursor) var(--e-enter); }
  .tr-plus b { position: absolute; left: 50%; top: 50%; width: 14px; height: 1.5px; margin: -0.75px 0 0 -7px; background: var(--ink); transition: background-color var(--t-cursor); }
  .tr-plus b + b { transform: rotate(90deg); }
  .tr-in:hover .tr-plus b, .tr-in:focus-visible .tr-plus b, .tr-x[open] .tr-plus b { background: var(--ctxs); }
  .tr-x[open] .tr-plus { transform: rotate(45deg); }
  .tr-in:active .tr-plus { transform: scale(0.8); }
  .tr-x[open] > .tr-in:active .tr-plus { transform: rotate(45deg) scale(0.8); }
  /* the opened panel grows from nothing (browsers that can animate to auto height) */
  .tr-x::details-content { block-size: 0; overflow: clip; transition: block-size var(--t-enter) var(--e-enter), content-visibility var(--t-enter) allow-discrete; }
  .tr-x[open]::details-content { block-size: auto; }
  .tr-more-in { display: grid; gap: 14px; justify-items: start; padding: 4px 12px 22px calc(52px + 20px + 10px); }
  .tr-p { max-width: 62ch; color: var(--ink); }
  .tr-links { display: flex; flex-wrap: wrap; gap: 8px 20px; }
  @media (prefers-reduced-motion: reduce) { .tr-x::details-content { transition: none; } .tr-plus { transition: none; } }
  @media (max-width: 900px) {
    .tr-in { grid-template-columns: 44px minmax(0, 1fr) 28px; padding-inline: 4px; }
    .tr-c, .tr-s { display: none; }
    .tr-more-in { padding-left: calc(44px + 20px + 4px); }
  }
</style>

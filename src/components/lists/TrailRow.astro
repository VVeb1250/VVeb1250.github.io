---
/**
 * @component TrailRow
 * @group lists
 * @summary Engineering trail: a tool or build that does not need a page, with what it is, one proof and evidence links. A compact row or a browseable item in HorizontalStrip.
 * @use Engineering trail on About: four cards in HorizontalStrip. The default row variant still belongs in a ul.rows.
 * @avoid Rows without a place to see the work; star counts as the only proof.
 * @behavior Card variant is the actual kit LabItem card, with Engineering trail facts in its body slot and WorkObject in its object slot. It uses Memory Base's shared ObjectReveal; moving the HorizontalStrip closes it. Evidence links retain their destinations.
 * @example
 * <ul class="rows"><TrailRow work="yasm" proof={{ en: '155 installs · 28 releases' }} where={[{ label: 'Marketplace', href: 'https://marketplace.visualstudio.com/…' }]} /></ul>
 */
import ExternalLink from '../primitives/ExternalLink.astro';
import CategoryTick from '../primitives/CategoryTick.astro';
import WorkObject from '../media/WorkObject.astro';
import LabItem from './LabItem.astro';
import { langOf, tx, type L } from '../../lib/i18n';
import { work } from '../../lib/works';
export interface Props {
  work: string;
  /** The single strongest checkable fact. Defaults to the work's `fact`. */
  proof?: L;
  /** Where to see it. Defaults to the work's `links`. */
  where?: { label: string; href: string }[];
  /** Cards are independent articles for HorizontalStrip; rows are list items. */
  variant?: 'row' | 'card';
}
const { work: id, proof, where, variant = 'row' } = Astro.props;
const lang = langOf(Astro.url);
const d = (await work(id)).data;
const links = where ?? d.links.map((l) => ({ label: l.label, href: l.url }));
const fact = proof ?? d.fact;
---
{variant === 'card' ? (
  <LabItem work={id} variant="card">
    <WorkObject slot="object" work={id} indexed />
    <div slot="body" class="tr-body">
      <span class="tr-y eyebrow num">{d.year}</span>
      <h3 class="disp">{d.title}</h3>
      <p>{tx(d.line, lang)}</p>
      <span class="tr-p">{fact && <span class="tr-f">{tx(fact, lang)}</span>}<CategoryTick cat={d.cat} kind={d.kind} /></span>
      <span class="tr-w">{links.map((l, i) => <ExternalLink href={l.href} bare data-object-go={i === 0 ? '' : undefined}>{l.label}</ExternalLink>)}</span>
    </div>
  </LabItem>
) : (
<li class="tr" data-cat={d.cat} data-work={id}>
  <span class="tr-y eyebrow num">{d.year}</span>
  <span class="tr-t"><b class="disp">{d.title}</b><span>{tx(d.line, lang)}</span></span>
  <span class="tr-p">{fact && <span class="tr-f">{tx(fact, lang)}</span>}<CategoryTick cat={d.cat} kind={d.kind} /></span>
  <span class="tr-w">{links.map((l) => <ExternalLink href={l.href} bare>{l.label}</ExternalLink>)}</span>
</li>
)}

<style>
  .tr { display: grid; grid-template-columns: 56px minmax(0, 1.4fr) minmax(0, 1fr) auto; gap: 8px 20px; align-items: center; padding: 16px 0; border-top: 1px solid var(--rule); }
  :global(.rows) > .tr:last-child { border-bottom: 1px solid var(--rule); }
  .tr-t { display: grid; gap: 2px; }
  .tr-t b { font-size: 20px; line-height: 1.2; }
  .tr-t span { font-size: 14px; color: var(--ink2); }
  .tr-p { display: grid; gap: 6px; justify-items: start; }
  .tr-f { font: 500 12px/1.4 var(--f-mono); color: var(--ink); }
  .tr-w { display: flex; flex-wrap: wrap; gap: 8px 16px; }
  .tr-body { display: grid; grid-template-columns: minmax(0, 1fr); gap: 8px; }
  .tr-body h3 { font-size: 22px; line-height: 1.15; }
  .tr-body p { font-size: 15px; color: var(--ink2); }
  .tr-body .tr-p { margin-top: 4px; }
  .tr-body .tr-w { margin-top: 4px; }
  @media (max-width: 760px) { .tr { grid-template-columns: 44px minmax(0, 1fr); } .tr .tr-p, .tr .tr-w { grid-column: 2; } }
</style>

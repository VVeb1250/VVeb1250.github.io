---
/**
 * @component ProjectContext
 * @group project
 * @summary The situation before the work: what existed, what was frustrating or worth testing, and why it was yours to take on. One strong sentence on the left, the rest as prose on the right.
 * @use Right after ProjectHeader on most work pages (the "IDEA / FRICTION → WOULD THIS WORK?" part of the story).
 * @avoid Background history nobody needs; restating the header's line.
 * @example
 * <ProjectContext label={{ en: 'Why' }} lead={{ en: 'The lab tools only ran on the lab machines.' }}>
 *   <p>…</p>
 * </ProjectContext>
 */
import { langOf, tx, type L } from '../../lib/i18n';
export interface Props {
  /** Small label, default "Context". */
  label?: L;
  /** The one sentence that frames the problem. */
  lead: L;
}
const { label, lead } = Astro.props;
const lang = langOf(Astro.url);
---
<section class="pc">
  <div class="pc-l"><span class="eyebrow l10n">{label ? tx(label, lang) : tx({ en: 'Context', th: 'ที่มา', ja: '背景' }, lang)}</span><p class="pc-lead disp">{tx(lead, lang)}</p></div>
  <div class="pc-r prose"><slot /></div>
</section>

<style>
  .pc { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: clamp(20px, 4vw, 64px); border-top: 1px solid var(--rule); padding-top: 16px; }
  .pc-l { display: grid; gap: 12px; align-content: start; }
  .pc-lead { font-weight: 600; font-size: clamp(24px, 2.8vw, 34px); line-height: 1.15; text-wrap: balance; }
  :global(:root[lang='th']) .pc-lead { line-height: 1.4; }
  @media (max-width: 820px) { .pc { grid-template-columns: minmax(0, 1fr); } }
</style>

---
/**
 * @component Trace
 * @group blocks
 * @summary A chaptered trace you scroll through step by step — a build log or a chain of beliefs. The sticky head keeps the odometer (`02 / 05`), the current step's name, progress, and a rail of every step (done · current · upcoming · failed). Each step is a chapter: type, date, title, text, what changed it, and real media (image, screen, clip, sprite, or any component via a slot).
 * @use Build logs (ART → SCENES → ANIMATION → CONTROL → DEMO), reasoning (ASSUMPTION → EXPERIMENT → WRONG → NEW MODEL), scope stories. 3–7 steps; give most steps an artifact so each scroll step shows a visible change.
 * @avoid Steps with nothing new to show (merge them); hiding failed steps; long paragraphs (1–3 sentences per step).
 * @behavior The step crossing 55% of the viewport becomes current: its rule turns into the context signal, the others dim, odometer + name roll 500ms, rail marker follows (240ms). Sprite clips play only while their step is current. Rail items jump to their step. Under 760px the head becomes a compact sticky bar and nothing dims. Reduced motion: no dimming transitions, sprites stay on their first frame.
 * @props-note Media per step: `media: { src | video+poster | strip: { src, frames, fps }, alt, caption, source, frame, marks }`. For anything else (a FlowDiagram, a CodeExcerpt) put the component in the slot named `s1`, `s2`… (1-based step number).
 * @example
 * <Trace label={{ en: 'Build notes' }} steps={[
 *   { type: 'FRICTION', short: 'convenience', text: { en: 'The original workflow was fragmented.' } },
 *   { type: 'BUILD', short: 'real toolchain', title: { en: 'The real toolchain, in the browser' }, text: { en: 'C16.EXE and the ET-Board simulator in DOSBox (WASM).' } },
 *   { type: 'OBSERVATION', short: '2 labs', date: '2026-09-26', text: { en: '69 visits, 11 assembles.' },
 *     media: { src: 'z80/goatcounter.webp', alt: { en: 'GoatCounter pages panel' }, frame: 'screen', source: 'GoatCounter' } }
 * ]}>
 *   <FlowDiagram slot="s2" … />
 * </Trace>
 */
import { getImage } from 'astro:assets';
import StatusTag from '../primitives/StatusTag.astro';
import EvidenceLink from '../primitives/EvidenceLink.astro';
import MediaFrame from '../media/MediaFrame.astro';
import { langOf, tx, type L } from '../../lib/i18n';
import { img } from '../../lib/media';
import type { Status } from '../../lib/vocab';

interface StepMedia {
  src?: string; video?: string; poster?: string;
  strip?: { src: string; frames: number; fps?: number };
  alt?: L; caption?: L; source?: L; frame?: 'plain' | 'screen'; marks?: { n: number; x: number; y: number }[];
}
interface Step {
  /** Kind of step in caps: ASSUMPTION, BUILD, ART, OBSERVATION… */
  type: string;
  /** 1–3 words for the rolling name and the rail. */
  short: string;
  /** Optional chapter title; without it the text is the headline. */
  title?: L;
  text: L;
  status?: Status;
  /** For a FAILED/changed step: what showed it was wrong. */
  because?: L;
  /** YYYY-MM-DD or YYYY-MM. */
  date?: string;
  media?: StepMedia;
  evidence?: { label: string; href?: string; shows?: L; kind?: 'pr' | 'release' | 'commit' | 'page' | 'video' | 'file' | 'private' }[];
}
export interface Props {
  /** Small label above the rolling step name (e.g. "Build notes", "Reasoning trace"). */
  label: L;
  steps: Step[];
  /** Hide the step rail in the head (for 3 steps or fewer it adds little). */
  rail?: boolean;
}
const { label, steps, rail = true } = Astro.props;
const lang = langOf(Astro.url);
const p = (n: number) => String(n).padStart(2, '0');
const uid = `tr-${tx(label, 'en').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}-${steps.length}`;
const slots = await Promise.all(steps.map((_, i) => (Astro.slots.has(`s${i + 1}`) ? Astro.slots.render(`s${i + 1}`) : Promise.resolve(''))));
const strips = await Promise.all(steps.map(async (s) => {
  if (!s.media?.strip) return null;
  const m = img(s.media.strip.src);
  const url = (await getImage({ src: m, format: 'webp', width: Math.min(m.width, 4800) })).src;
  return { url, n: s.media.strip.frames, fps: s.media.strip.fps ?? 12, ar: `${m.width / s.media.strip.frames}/${m.height}` };
}));
---
<section class="tr" id={uid}>
  <div class="tr-head">
    <div class="odo disp num" aria-hidden="true"><span class="reel">{steps.map((_, i) => <span>{p(i + 1)}</span>)}</span><small>/ {p(steps.length)}</small></div>
    <div class="tr-now">
      <p class="eyebrow l10n">{tx(label, lang)}</p>
      <div class="roll" aria-hidden="true"><span class="reel">{steps.map((s) => <span>{s.short}</span>)}</span></div>
      <div class="bar" aria-hidden="true"><i></i></div>
    </div>
    {rail && (
      <ol class="tr-rail">
        {steps.map((s, i) => (
          <li data-status={s.status ?? ''}><a href={`#${uid}-${i + 1}`}><i aria-hidden="true"></i><span class="num">{p(i + 1)}</span><span>{s.short}</span></a></li>
        ))}
      </ol>
    )}
  </div>
  <ol class="tr-body">
    {steps.map((s, i) => (
      <li class="step" id={`${uid}-${i + 1}`} data-status={s.status ?? ''} data-cur={i === 0 ? '' : undefined}>
        <div class="step-h">
          <span class="eyebrow">{s.type}</span>
          {s.date && <time class="eyebrow num" datetime={s.date}>{s.date}</time>}
          {s.status && <StatusTag status={s.status} />}
        </div>
        {s.title ? <h3 class="disp step-t">{tx(s.title, lang)}</h3> : null}
        <p class:list={['step-x', { lead: !s.title }]}>{tx(s.text, lang)}</p>
        {s.because && <p class="because"><span aria-hidden="true">↳ </span>{tx(s.because, lang)}</p>}
        {s.media && (s.media.src || s.media.video) && (
          <div class="step-m"><MediaFrame src={s.media.src} video={s.media.video} poster={s.media.poster} loop={!!s.media.video} alt={s.media.alt} frame={s.media.frame ?? 'plain'} marks={s.media.marks} caption={s.media.caption} source={s.media.source} /></div>
        )}
        {strips[i] && (
          <figure class="step-m step-strip">
            <div class="strip" role="img" aria-label={tx(s.media!.alt ?? s.short, lang)} data-n={strips[i]!.n} data-fps={strips[i]!.fps} style={`background-image:url(${strips[i]!.url});aspect-ratio:${strips[i]!.ar};--n:${strips[i]!.n};--i:0`}></div>
            {(s.media!.caption || s.media!.source) && <figcaption>{s.media!.caption && tx(s.media!.caption, lang)}{s.media!.source && <small> · {tx(s.media!.source, lang)}</small>}</figcaption>}
          </figure>
        )}
        {slots[i] && <div class="step-m" set:html={slots[i]} />}
        {s.evidence?.length ? <div class="step-e">{s.evidence.map((e) => <EvidenceLink {...e} />)}</div> : null}
      </li>
    ))}
  </ol>
</section>

<style>
  .tr { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: clamp(24px, 4vw, 64px); }
  .tr-head { position: sticky; top: calc(var(--hdr-h) + 32px); align-self: start; display: grid; gap: 18px; }
  .odo { font-size: 112px; line-height: 1; height: 1em; overflow: hidden; display: flex; align-items: flex-start; }
  .reel { display: flex; flex-direction: column; transition: transform var(--t-roll) var(--e-enter); }
  .odo .reel span { display: block; height: 1em; }
  .odo small { font: 500 13px/1 var(--f-mono); color: var(--ink2); align-self: flex-end; margin: 0 0 12px 8px; }
  .tr-now { display: grid; gap: 6px; }
  .roll { height: 1.5em; overflow: hidden; font-weight: 600; font-size: 15px; line-height: 1.5; }
  .roll .reel span { display: block; height: 1.5em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .bar { position: relative; height: 2px; background: repeating-linear-gradient(90deg, var(--ink3) 0 2px, transparent 2px 6px); }
  .bar i { position: absolute; inset: 0; transform-origin: 0 50%; transform: scaleX(0); background: var(--ctxs); }
  /* rail: every step, with its state (Endfield track: done · current · upcoming · locked) */
  .tr-rail { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; border-left: 1px solid var(--rule); }
  .tr-rail a { display: grid; grid-template-columns: 10px 22px minmax(0, 1fr); gap: 8px; align-items: center; padding: 5px 0 5px 12px; margin-left: -1px; border-left: 2px solid transparent; font-size: 13px; color: var(--ink3); text-decoration: none; transition: color var(--t-cursor), border-color var(--t-cursor) var(--e-enter); }
  .tr-rail a:hover { color: var(--ink); }
  .tr-rail .num { font: 500 11px/1 var(--f-mono); }
  .tr-rail i { width: 8px; height: 8px; border: 1.5px solid currentColor; }
  .tr-rail li[data-status='FAILED'] i { background: linear-gradient(135deg, transparent 43%, currentColor 43% 57%, transparent 57%); }
  .tr-rail li.past a { color: var(--ink2); }
  .tr-rail li.past i { background-color: var(--ctxs); border-color: var(--ctxs); }
  .tr-rail li.past[data-status='FAILED'] i { background: linear-gradient(135deg, transparent 43%, var(--ink2) 43% 57%, transparent 57%); border-color: var(--ink2); }
  .tr-rail li.cur a { color: var(--ink); font-weight: 600; border-left-color: var(--ctxs); }
  .tr-rail li.cur i { background: var(--ink); border-color: var(--ink); }
  /* steps = chapters */
  .tr-body { list-style: none; margin: 0; padding: 0 0 18vh; display: grid; gap: clamp(120px, 22vh, 240px); }
  .step { display: grid; gap: 14px; align-content: start; padding-top: 14px; border-top: 1px solid var(--rule); position: relative; transition: opacity var(--t-roll) var(--e-enter); }
  .step::before { content: ''; position: absolute; left: 0; top: -1px; height: 3px; width: 0; background: var(--ctxs); transition: width var(--t-line) var(--e-enter); }
  .step[data-cur]::before { width: 100%; }
  .step-h { display: flex; flex-wrap: wrap; gap: 8px 16px; align-items: center; }
  .step-h time { color: var(--ink3); }
  .step-t { font-size: clamp(26px, 3vw, 38px); line-height: 1.08; text-wrap: balance; }
  .step-x { font-size: 17px; max-width: 58ch; }
  .step-x.lead { font-size: clamp(20px, 2.2vw, 26px); line-height: 1.35; max-width: 40ch; }
  :global(:root[lang='th']) .step-x.lead { line-height: 1.55; }
  .step[data-status='FAILED'] .step-x { text-decoration: line-through; text-decoration-color: var(--ink3); text-decoration-thickness: 1.5px; color: var(--ink2); }
  .because { font-size: 16px; color: var(--ink); padding-left: 12px; border-left: 1px solid var(--ctxs); max-width: 58ch; }
  .step-m { margin-top: 8px; }
  .step-strip { display: grid; gap: 8px; background: var(--sunk); border: 1px solid var(--rule); padding: 12px; justify-items: center; }
  .strip { width: min(100%, 420px); background-repeat: no-repeat; background-size: calc(var(--n) * 100%) 100%; background-position-x: calc(var(--i) / (var(--n) - 1) * 100%); }
  .step-strip figcaption { font-size: 14px; color: var(--ink2); justify-self: start; }
  .step-strip small { font: 500 11px var(--f-mono); color: var(--ink3); }
  .step-e { display: grid; gap: 6px; }
  @media (min-width: 761px) and (prefers-reduced-motion: no-preference) {
    .tr.live .step:not([data-cur]) { opacity: 0.42; }
  }
  @media (max-width: 760px) {
    .tr { grid-template-columns: minmax(0, 1fr); }
    .tr-head { top: var(--hdr-h); z-index: 5; background: color-mix(in srgb, var(--bg) 92%, transparent); padding-block: 8px; grid-template-columns: auto 1fr; align-items: end; gap: 12px; }
    .odo { font-size: 56px; }
    .tr-rail { display: none; }
    .tr-body { padding-bottom: 6vh; gap: 72px; }
  }
</style>

<script>
  import { onPage, reducedMotion } from '../../scripts/lifecycle';
  import { onScroll } from '../../scripts/scroll';
  onPage(() => {
    // section.tr: TrailRow's <li class="tr"> shares the class name
    const traces = [...document.querySelectorAll<HTMLElement>('section.tr')];
    if (!traces.length) return;
    const timers = new Map<HTMLElement, number>();
    const stopStrip = (el: HTMLElement) => { clearInterval(timers.get(el)); timers.delete(el); };
    const playStrip = (el: HTMLElement) => {
      if (timers.has(el) || reducedMotion()) return;
      const n = +el.dataset.n!, fps = +el.dataset.fps!;
      let k = 0;
      timers.set(el, window.setInterval(() => { k = (k + 1) % n; el.style.setProperty('--i', String(k)); }, 1000 / fps));
    };
    const state = new Map<HTMLElement, number>();
    traces.forEach((t) => t.classList.add('live'));
    const off = onScroll((_, vh) => {
      for (const tr of traces) {
        const r = tr.getBoundingClientRect();
        if (r.bottom < 0 || r.top > vh) { tr.querySelectorAll<HTMLElement>('.strip').forEach(stopStrip); continue; }
        const steps = [...tr.querySelectorAll<HTMLElement>(':scope > .tr-body > .step')];
        let n = 0;
        steps.forEach((s, i) => { if (s.getBoundingClientRect().top < vh * 0.55) n = i; });
        const body = tr.querySelector<HTMLElement>('.tr-body')!.getBoundingClientRect();
        const prog = Math.min(1, Math.max(0, (vh * 0.55 - body.top) / Math.max(1, body.height - vh * 0.3)));
        tr.querySelector<HTMLElement>('.bar i')!.style.transform = `scaleX(${prog.toFixed(3)})`;
        if (state.get(tr) === n) continue;
        state.set(tr, n);
        steps.forEach((s, i) => { s.toggleAttribute('data-cur', i === n); s.toggleAttribute('data-past', i < n); });
        tr.querySelectorAll<HTMLElement>('.tr-rail li').forEach((li, i) => { li.classList.toggle('cur', i === n); li.classList.toggle('past', i < n); });
        const reels = tr.querySelectorAll<HTMLElement>('.tr-head .reel');
        if (reels[0]) reels[0].style.transform = `translateY(${-n}em)`;
        if (reels[1]) reels[1].style.transform = `translateY(${-n * 1.5}em)`;
        steps.forEach((s, i) => s.querySelectorAll<HTMLElement>('.strip').forEach((el) => (i === n ? playStrip(el) : stopStrip(el))));
      }
    });
    return () => { off(); timers.forEach((t) => clearInterval(t)); timers.clear(); };
  });
</script>

---
/**
 * @component ComboEntries
 * @group showcase
 * @summary MyCombo's twelve direct task entries and the shared practices they use, drawn as a theme-aware SVG.
 * @use On MyCombo's story and Work reel; entry names come from the current pack.
 * @avoid Treating the shared core as a required router step. The router is a fallback for unclear or cross-workflow requests.
 * @behavior Static and fluid; every entry remains legible at 390px in light and dark mode.
 * @example
 * <div data-cat="tool"><ComboEntries /></div>
 */
import { COMBO_TASKS } from '../../lib/combo-branches';
---
<svg class="combo-entries" viewBox="0 0 360 392" role="img" aria-label="Twelve direct task entries sharing one set of practices">
  <title>Twelve direct task entries, one shared core</title>
  <g class="wires">
    {COMBO_TASKS.map((_, i) => <path d={`M90 196 C126 196 115 ${20 + i * 32} 150 ${20 + i * 32} H158`} />)}
  </g>
  <rect class="core" x="8" y="164" width="82" height="64" rx="2" />
  <text class="core-label" x="18" y="188">SHARED</text>
  <text class="core-label" x="18" y="207">PRACTICES</text>
  {COMBO_TASKS.map((entry, i) => <g class="entry">
    <circle cx="160" cy={20 + i * 32} r="3" />
    <text x="174" y={25 + i * 32}>{entry}</text>
    <line x1="174" y1={31 + i * 32} x2="348" y2={31 + i * 32} />
  </g>)}
</svg>
<style>
  .combo-entries { display: block; width: 100%; height: auto; overflow: visible; }
  .wires path { fill: none; stroke: var(--ctxs); stroke-width: 1.25; opacity: .78; }
  .core { fill: var(--ctxp); stroke: var(--ctxs); stroke-width: 1.5; }
  .core-label { fill: var(--ink); font: 600 11px var(--f-mono); letter-spacing: .015em; }
  .entry circle { fill: var(--ctxs); }
  .entry text { fill: var(--ink); font: 500 15px var(--f-mono); }
  .entry line { stroke: var(--rule); stroke-width: 1; }
</style>

---
/**
 * Home: the name and the plain facts a hiring reader needs (study, the internship, contact) → three selected works →
 * the ways on (Work, Archive, About) → contact. No tagline, no argument about what the work proves (Story §0.3);
 * who-did-what sits on each work page. Everything shown lives on /work/; everything, by year, on /timeline/.
 */
import PageShell from '../../layouts/PageShell.astro';
import Section from '../../components/shell/Section.astro';
import HomeCover from '../../components/home/HomeCover.astro';
import SelectedWork from '../../components/home/SelectedWork.astro';
import VajaFeature from '../../components/home/VajaFeature.astro';
import Z80Feature from '../../components/home/Z80Feature.astro';
import OSSFeature from '../../components/home/OSSFeature.astro';
import ContactCard from '../../components/home/ContactCard.astro';
import GoLink from '../../components/primitives/GoLink.astro';
import { localePaths, langOf, href, tx } from '../../lib/i18n';
import { allWorks } from '../../lib/works';
import { SHOWCASE, SITE } from '../../lib/site';
import { oss } from '../../lib/facts';

export const getStaticPaths = () => localePaths();
const lang = langOf(Astro.url);
const CV = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}${SITE.cv}`;
const LOOKING = { en: 'An AI engineering internship.', th: 'ที่ฝึกงานสาย AI engineering', ja: 'AIエンジニアリングのインターン。' };
const timelineCount = (await allWorks()).length;
const WORK_COUNT = SHOWCASE.length; // the panels on /work/
const DOORS = [
  { to: '/work/', t: { en: 'Work', th: 'ผลงาน', ja: '作品' }, n: WORK_COUNT, d: { en: 'Everything I show, side by side.', th: 'ผลงานทั้งหมดที่ผมนำมาแสดงไว้', ja: 'これまでに見せている作品を、すべて並べて表示しています。' } },
  { to: '/timeline/', t: { en: 'Timeline', th: 'ไทม์ไลน์', ja: '年表' }, n: timelineCount, d: { en: 'Everything by year — work, competitions, teaching.', th: 'ทุกอย่างตามปี — งาน การแข่งขัน การสอน', ja: '年ごとのすべて — 作品、大会、指導。' } },
  { to: '/about/', t: { en: 'About', th: 'เกี่ยวกับ', ja: '概要' }, d: { en: 'Study, the path so far, drawing and drums.', th: 'การเรียน เส้นทางที่ผ่านมา การวาดและกลอง', ja: '学び、これまでの道のり、描くことと、ドラム。' } }
];
// OSS on Home: the same threads as the work page, said shortly; the full account (and who did what) is on /work/oss/
const step = (ref: string) => { const r = oss(ref); return { ref: r.ref, kind: r.kind, state: r.state, href: r.url, text: r.short }; };
const OSS_THREADS = [
  { repo: 'AgentsMesh', place: 'main' as const, steps: ['#98', '#99', '#102'].map(step) },
  { repo: 'ai-config-sync-manager', place: 'side' as const, steps: ['#28'].map(step) },
  { repo: 'context-mode', place: 'low' as const, steps: ['#878'].map(step) }
];---
<PageShell title="">
  <div class="wrap home">
    <HomeCover study={{ en: 'Computer Engineering (CoE)', th: 'วิศวกรรมคอมพิวเตอร์ (CoE)', ja: 'コンピュータ工学' }}
      school={{ en: 'Khon Kaen University · year 3 · expected 2028', th: 'มหาวิทยาลัยขอนแก่น · ปี 3 · คาดว่าจบ 2028', ja: 'コンケン大学 · 3年 · 2028年卒業予定' }}
      looking={LOOKING} workCount={WORK_COUNT}>
    </HomeCover>

    <Section id="work" index="01" title={{ en: 'Selected work', th: 'ผลงานที่เลือก', ja: '選んだ作品' }} mark={{ en: 'Work', th: 'ผลงาน', ja: '作品' }} count={3} tight>
      <SelectedWork>
        <VajaFeature attribution={false} />
        <Z80Feature credit="" why={{ en: 'The course’s assembler and board simulator are separate old DOS programs. The setup took a lot before it worked, and I had to remember commands I didn’t need, so I built one place to write, assemble and run.', th: 'แบบเก่ายุ่งยากกว่าจะใช้ได้ ต้องจำ command การใช้งานที่ไม่จำเป็นสำหรับผม', ja: '授業のアセンブラとボードシミュレータは、別々の古い DOS プログラムです。準備に時間がかかり、使わないコマンドも覚える必要があったため、書く・アセンブルする・実行するを1か所にまとめました。' }} />
        <OSSFeature credit="" threads={OSS_THREADS} />
      </SelectedWork>
    </Section>

    <nav class="doors" aria-label={tx({ en: 'More', th: 'เพิ่มเติม', ja: 'もっと' }, lang)} data-mark={tx({ en: 'More', th: 'เพิ่มเติม', ja: 'もっと' }, lang)}>
      {DOORS.map((d, i) => (
        <a href={href(d.to, lang)} data-reveal style={`--i:${i}`}>
          <span class="disp dr-t">{tx(d.t, lang)}{d.n != null && <span class="num dr-n">[{String(d.n).padStart(2, '0')}]</span>}</span>
          <span class="dr-d">{tx(d.d, lang)}</span>
          <GoLink lineOnly />
        </a>
      ))}
    </nav>

    <div id="contact" class="home-end" data-mark="Contact">
      <ContactCard looking={LOOKING} cv={CV} />
    </div>
  </div>
</PageShell>

<style>
  .home { --space-section: clamp(72px, 9vw, 128px); }
  .doors { margin-top: var(--space-section); display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--ink); }
  .doors a { display: grid; gap: 10px; align-content: start; padding: 22px clamp(16px, 2vw, 28px) 26px 0; color: inherit; text-decoration: none; position: relative; }
  .doors a + a { padding-left: clamp(16px, 2vw, 28px); border-left: 1px solid var(--rule); }
  .dr-t { font-size: clamp(48px, 6.4vw, 104px); line-height: 0.9; display: flex; gap: 0.12em; align-items: flex-start; transition: color var(--t-line) var(--e-enter); }
  .dr-n { font: 500 13px/1 var(--f-mono); color: var(--ink3); margin-top: 0.5em; }
  .doors a:hover .dr-t { color: var(--acc); }
  .dr-d { color: var(--ink2); max-width: 30ch; }
  .home-end { margin-top: var(--space-section); }
  @media (max-width: 820px) {
    .doors { grid-template-columns: minmax(0, 1fr); }
    .doors a + a { padding-left: 0; border-left: 0; border-top: 1px solid var(--rule); }
  }
</style>

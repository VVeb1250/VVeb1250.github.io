---
/**
 * /kit — every component, live, with the rules from its own header. Switch EN / TH / JA in the header to see
 * every specimen in that language. Content in specimens is real (from src/content) unless tagged SAMPLE WORDING.
 */
import PageShell from '../../../layouts/PageShell.astro';
import Specimen from '../../../components/kit/Specimen.astro';
import Tokens from '../../../components/kit/Tokens.astro';
import { parseDoc, GROUPS } from '../../../../scripts/docparse.mjs';
import { localePaths, langOf, href } from '../../../lib/i18n';
// shell
import Section from '../../../components/shell/Section.astro';
import SectionHeader from '../../../components/shell/SectionHeader.astro';
// primitives
import Callout from '../../../components/primitives/Callout.astro';
import CategoryTick from '../../../components/primitives/CategoryTick.astro';
import Signature from '../../../components/primitives/Signature.astro';
import CopyText from '../../../components/primitives/CopyText.astro';
import Counter from '../../../components/primitives/Counter.astro';
import EvidenceLink from '../../../components/primitives/EvidenceLink.astro';
import ExternalLink from '../../../components/primitives/ExternalLink.astro';
import GoLink from '../../../components/primitives/GoLink.astro';
import Mark from '../../../components/primitives/Mark.astro';
import MetaLine from '../../../components/primitives/MetaLine.astro';
import MetaList from '../../../components/primitives/MetaList.astro';
import Quote from '../../../components/primitives/Quote.astro';
import RoleTag from '../../../components/primitives/RoleTag.astro';
import StatusTag from '../../../components/primitives/StatusTag.astro';
import Readout from '../../../components/primitives/Readout.astro';
// media
import Figure from '../../../components/media/Figure.astro';
import FlowDiagram from '../../../components/media/FlowDiagram.astro';
import ScrubFrames from '../../../components/media/ScrubFrames.astro';
import PhotoCard from '../../../components/media/PhotoCard.astro';
import PortraitSwap from '../../../components/media/PortraitSwap.astro';
import IsoObject from '../../../components/media/IsoObject.astro';
import Pictogram from '../../../components/media/Pictogram.astro';
import SketchReveal from '../../../components/media/SketchReveal.astro';
import WorkObject from '../../../components/media/WorkObject.astro';
import PRCard from '../../../components/project/PRCard.astro';
import RefBoard from '../../../components/project/RefBoard.astro';
import FallbackNotice from '../../../components/primitives/FallbackNotice.astro';
import ContactCard from '../../../components/home/ContactCard.astro';
import FrameStepper from '../../../components/media/FrameStepper.astro';
import ImageCaption from '../../../components/media/ImageCaption.astro';
import MediaFrame from '../../../components/media/MediaFrame.astro';
import Plate from '../../../components/media/Plate.astro';
import Stage from '../../../components/media/Stage.astro';
import VideoEmbed from '../../../components/media/VideoEmbed.astro';
// blocks
import AttributionBlock from '../../../components/blocks/AttributionBlock.astro';
import ClaimLedger from '../../../components/blocks/ClaimLedger.astro';
import CodeExcerpt from '../../../components/blocks/CodeExcerpt.astro';
import ConstraintBlock from '../../../components/blocks/ConstraintBlock.astro';
import ContributionBlock from '../../../components/blocks/ContributionBlock.astro';
import HorizontalStrip from '../../../components/blocks/HorizontalStrip.astro';
import Inspector from '../../../components/blocks/Inspector.astro';
import ScrollStepper from '../../../components/blocks/ScrollStepper.astro';
import OutcomeBlock from '../../../components/blocks/OutcomeBlock.astro';
import ProcessLine from '../../../components/blocks/ProcessLine.astro';
import Retrospective from '../../../components/blocks/Retrospective.astro';
import SplitScroll from '../../../components/blocks/SplitScroll.astro';
import Timeline from '../../../components/blocks/Timeline.astro';
import Trace from '../../../components/blocks/Trace.astro';
// lists
import ArchiveList from '../../../components/lists/ArchiveList.astro';
import TimelineRow from '../../../components/lists/TimelineRow.astro';
import ArchiveRow from '../../../components/lists/ArchiveRow.astro';
import EvidenceRow from '../../../components/lists/EvidenceRow.astro';
import LabItem from '../../../components/lists/LabItem.astro';
import MilestoneItem from '../../../components/lists/MilestoneItem.astro';
import RelatedWork from '../../../components/lists/RelatedWork.astro';
import TrailRow from '../../../components/lists/TrailRow.astro';
// project
import NextWork from '../../../components/project/NextWork.astro';
import ProjectContext from '../../../components/project/ProjectContext.astro';
import ProjectHeader from '../../../components/project/ProjectHeader.astro';
import WorkNav from '../../../components/project/WorkNav.astro';
// home
import IntroHero from '../../../components/home/IntroHero.astro';
import HomeCover from '../../../components/home/HomeCover.astro';
import ReelOSS from '../../../components/showcase/ReelOSS.astro';
import Draft from '../../../components/primitives/Draft.astro';
import { SHOWCASE } from '../../../lib/site';
import NowBar from '../../../components/home/NowBar.astro';
import VajaFeature from '../../../components/home/VajaFeature.astro';
import Z80Feature from '../../../components/home/Z80Feature.astro';
import OSSFeature from '../../../components/home/OSSFeature.astro';

export const getStaticPaths = () => localePaths();
const raws = import.meta.glob<string>('/src/components/**/*.astro', { query: '?raw', import: 'default', eager: true });
const docs = Object.entries(raws).filter(([f]) => !f.includes('/kit/')).map(([f, s]) => parseDoc(s, f)).filter(Boolean) as any[];
const byGroup = GROUPS.map((g) => ({ ...g, items: docs.filter((d) => d.group === g.key).map((d) => d.name).sort() }));
const tokensCode = `export const H = 248; // identity hue — locked to Azure by the owner

// Tier 3 recipe shared by every kind: deep → mid → pale make the plate gradient; s = the kind's signal (state, dots, hover).
export const RECIPE = {
  light: { d: [0.73, 0.1], m: [0.8, 0.08], p: [0.89, 0.04], s: [0.5, 0.15] },
  dark: { d: [0.44, 0.1], m: [0.36, 0.08], p: [0.27, 0.04], s: [0.76, 0.12] }
};`;
---
<PageShell title="Kit" allFonts noindex>
  <div class="wrap kit">
    <header class="kit-top" data-mark="Kit">
      <p class="eyebrow">Component kit · {docs.length} components</p>
      <h1 class="disp" data-mark-trigger>Structure stable, composition flexible.</h1>
      <p class="kit-lead">Every component of the site, live, with the rules written in its own file. Switch <b>EN · TH · JA</b> and <b>Auto / Light / Dark</b> in the header to see each one in every language and theme. Reference for AI: <code>docs/COMPONENTS.md</code>, <code>docs/STORY-RECIPES.md</code>, <code>AGENTS.md</code>.</p>
      <p class="kit-tools"><button type="button" class="kit-b" onclick="window.__lqReplay && window.__lqReplay()">Replay image loading</button> <span class="kit-tip">Shows the loading state of every image on screen (blurred preview → the real picture develops in), as on a slow connection.</span></p>
    </header>

    <div class="kit-grid">
      <nav class="kit-nav" aria-label="Kit index">
        <details open>
          <summary class="eyebrow">Index</summary>
          <ol>
            <li><a href="#tokens">Tokens</a></li>
            {byGroup.map((g) => <li><a href={`#g-${g.key}`}>{g.title}</a><ol>{g.items.map((n) => <li><a href={`#c-${n}`}>{n}</a></li>)}</ol></li>)}
          </ol>
        </details>
      </nav>

      <div class="kit-body">
        <section id="tokens" class="grp" data-mark="Tokens">
          <SectionHeader title="Tokens" description="Colors are generated from scripts/tokens.config.mjs (npm run tokens) and fail the build if contrast drops." />
          <Tokens />
        </section>

        <!-- ================= SHELL ================= -->
        <section id="g-shell" class="grp" data-mark="Shell">
          <SectionHeader index="01" title="Shell" description={GROUPS[0].note} />
          <Specimen name="SiteNav" live={false} note="The header at the top of this page. Desktop links have wider click targets; hover the nav to see the cursor follow you." />
          <Specimen name="LanguageToggle" live={false} note="EN · TH · JA in the header." />
          <Specimen name="ThemeToggle" live={false} note="Auto / Light / Dark in the header." />
          <Specimen name="SectionMarker" live={false} note="Scroll: once a section title passes under the header, its name appears vertically at the top-left (wide screens)." />
          <Specimen name="PageScrollbar" live={false} note="Grey dashed track, context-colored progress and a small deep cyan (light) or spark (dark) cursor at the right edge below the header. Drag it to scroll." />
          <Specimen name="Atmosphere" live={false} note="The misty background behind this page. Identity wash here; work pages tint it with the work's color." />
          <Specimen name="Footer" live={false} note="Bottom of this page." />
          <Specimen name="LoadLine" live={false} note="At the very top of the window, only when a page takes longer than 150 ms to arrive. Links prefetch on hover, so on a good connection you will rarely see it." />
          <Specimen name="SectionHeader">
            <SectionHeader index="02" title={{ en: 'Sheets, frames, captures', th: 'ชิ้นส่วน เฟรม และภาพจากหน้าจอ' }} description={{ en: 'One sentence under the title, when it helps.' }} count={3} trigger={false} />
          </Specimen>
          <Specimen name="Section">
            <Section title={{ en: 'Milestones & community', th: 'Milestones และชุมชน' }} tight>
              <ul class="rows"><MilestoneItem date="2024" kind="award" title={{ en: 'AISE CAMP #2 — 2nd runner-up', th: 'AISE CAMP #2 — รองชนะเลิศอันดับ 2', ja: 'AISE CAMP #2 — 3位' }} /></ul>
            </Section>
          </Specimen>
        </section>

        <!-- ================= PRIMITIVES ================= -->
        <section id="g-primitives" class="grp" data-mark="Primitives">
          <SectionHeader index="02" title="Primitives" description={GROUPS[1].note} />
          <Specimen name="StatusTag">
            <div class="row"><StatusTag status="ACTIVE" cat="ai" /><StatusTag status="WIP" /><StatusTag status="COMPLETED" /><StatusTag status="VALIDATED" /><StatusTag status="FAILED" /><StatusTag status="RETIRED" /><StatusTag status="ARCHIVED" /><StatusTag status="REVISITING" /><StatusTag status="NOT STARTED" /></div>
          </Specimen>
          <Specimen name="Signature">
            <div class="row" style="font-size:56px;gap:32px;align-items:center"><Signature name="web" label="Web" write /><Signature name="teethawat" label="teethawat" /><Signature name="teethawat-th" label="ธีร์ธวัช" /></div>
          </Specimen>
          <Specimen name="CategoryTick">
            <div class="row"><CategoryTick cat="game" /><CategoryTick cat="ai" /><CategoryTick cat="dev" /><CategoryTick cat="tool" /><CategoryTick cat="sys" /><CategoryTick cat="ui" /><CategoryTick cat="hw" /></div>
          </Specimen>
          <Specimen name="MetaLine">
            <div class="col"><MetaLine items={[{ en: 'Project head', th: 'หัวหน้าโปรเจกต์', ja: 'プロジェクトリーダー' }, { en: 'team of 3', th: 'ทีม 3 คน', ja: '3人チーム' }, '2025']} tone="ink" /><MetaLine items={['Monaco', 'DOSBox → WASM', 'C16.EXE']} /></div>
          </Specimen>
          <Specimen name="MetaList">
            <MetaList items={[{ k: { en: 'Built', th: 'ทำเมื่อ', ja: '制作' }, v: { en: '9 days · 2026-07-22 → 07-30', th: '9 วัน · 2026-07-22 → 07-30', ja: '9日間 · 2026-07-22 → 07-30' } }, { k: { en: 'Commits', th: 'Commits', ja: 'コミット' }, v: { en: '59 of 64 · 5 releases', th: '59 จาก 64 · 5 release', ja: '64中59 · 5リリース' } }, { k: 'Stack', v: 'Monaco · DOSBox → WASM · C16.EXE' }]} />
          </Specimen>
          <Specimen name="RoleTag">
            <div class="row"><RoleTag me>Project head</RoleTag><RoleTag me>Art</RoleTag><RoleTag me>Player control</RoleTag><RoleTag>Story (team)</RoleTag></div>
          </Specimen>
          <Specimen name="Counter">
            <div class="row"><Counter value={2} total={4} size="lg" /><Counter value={3} total={5} style="bracket" /></div>
          </Specimen>
          <Specimen name="Readout">
            <div data-cat="dev" class="col gap">
              <div class="readouts">
                <Readout value={9} unit={{ en: 'days', th: 'วัน', ja: '日' }} label={{ en: 'Z80 Workspace · 2026-07-22 → 07-30', th: 'Z80 Workspace · 2026-07-22 → 07-30', ja: 'Z80 Workspace · 2026-07-22 → 07-30' }} source="GitHub" />
                <Readout value={59} total={64} unit={{ en: 'commits', th: 'commit', ja: 'コミット' }} label={{ en: 'mine, of the repo', th: 'ของผม ใน repo', ja: '自分の分 · リポジトリ' }} source="GitHub" />
                <Readout value={5} unit={{ en: 'releases', th: 'release', ja: 'リリース' }} source="GitHub" />
              </div>
              <div class="narrow"><Readout size="sm" value={27} total={93} unit={{ en: 'commits', th: 'commit', ja: 'コミット' }} label={{ en: 'mine, in the MSU final', th: 'ของผม ในรอบชิง MSU', ja: '自分の分 · MSU決勝' }} source={{ en: 'team repo', th: 'repo ของทีม', ja: 'チームのリポジトリ' }} /></div>
            </div>
          </Specimen>
          <Specimen name="GoLink">
            <a class="row demo-link" href="#c-GoLink"><GoLink /></a>
          </Specimen>
          <Specimen name="Mark">
            <div class="row"><Mark n={1} /><Mark n={2} /><Mark n={3} /><span data-cat="dev" class="row"><Mark n={1} /><Mark n={2} /></span></div>
          </Specimen>
          <Specimen name="ExternalLink">
            <div class="row"><ExternalLink href="https://github.com/VVeb1250">GitHub</ExternalLink><ExternalLink href="https://www.pixiv.net/en/users/116719673">Pixiv</ExternalLink></div>
          </Specimen>
          <Specimen name="EvidenceLink">
            <div class="col"><EvidenceLink label="agentsmesh #102" shows={{ en: 'merged', th: 'merged', ja: 'マージ済み' }} kind="pr" /><EvidenceLink label="rop-algorithm" shows={{ en: 'private, archived', th: 'private, archived', ja: '非公開・アーカイブ' }} kind="private" /><EvidenceLink label="PlayerController.cs" shows={{ en: '370 lines', th: '370 บรรทัด', ja: '370行' }} kind="file" /></div>
          </Specimen>
          <Specimen name="Quote">
            <div class="col"><Quote size="lg" text="Make AI-built frontends feel designed." source={{ en: 'WhipUI · the package’s tagline' }} /></div>
          </Specimen>
          <Specimen name="Callout">
            <div class="demo-text"><Callout place="inline">The counts may include my own testing.</Callout><p>GoatCounter counted 69 visits and 11 assembles between 20 July and 26 September 2026.</p></div>
          </Specimen>
          <Specimen name="CopyText">
            <div class="col"><CopyText text="npx whipui init" /><CopyText text="supimol.web@gmail.com" /></div>
          </Specimen>
          <Specimen name="FallbackNotice">
            <p class="sample">Visible only on /th/kit/ and /ja/kit/ (on English pages it renders nothing). Work pages add it on their own.</p>
            <FallbackNotice shown="en" />
          </Specimen>
          <Specimen name="Draft" live={false} note="Renders only in `npm run dev` (dashed outline + DRAFT label) and is stripped from production — so nothing appears here on the live site. See the Vaja and Z80 stories: the proposed question and retrospective are wrapped in <Draft>." />
        </section>

        <!-- ================= MEDIA ================= -->
        <section id="g-media" class="grp" data-mark="Media">
          <SectionHeader index="03" title="Media" description={GROUPS[2].note} />
          <Specimen name="MediaFrame">
            <MediaFrame src="z80/workspace.webp" alt={{ en: 'Z80 Workspace welcome screen with explorer, toolbar and console' }} frame="screen"
              marks={[{ n: 1, x: 4, y: 9.4 }, { n: 2, x: 16.8, y: 88.6 }, { n: 3, x: 20.6, y: 2.6 }]}
              title={{ en: 'Workspace', th: 'Workspace', ja: 'ワークスペース' }} caption={{ en: '① explorer · ② the console runs the real C16.EXE in DOSBox · ③ Run Z80sim opens the ET-Board simulator.', th: '① explorer · ② console รัน C16.EXE ตัวจริงใน DOSBox · ③ Run Z80sim เปิด ET-Board simulator', ja: '① エクスプローラー · ② コンソールがDOSBox内の本物のC16.EXEを実行 · ③ Run Z80simでET-Boardシミュレータを開く' }} />
          </Specimen>
          <Specimen name="ImageCaption">
            <ImageCaption n={2} title={{ en: 'Gameplay · 51 s · no sound', th: 'Gameplay · 51 วินาที · ไม่มีเสียง', ja: 'ゲームプレイ · 51秒 · 無音' }} text={{ en: 'Cut from a recorded build.', th: 'ตัดจาก build ที่อัดไว้', ja: '録画したビルドから編集。' }} source="Journey of Vaja build, 2025" />
          </Specimen>
          <Specimen name="VideoEmbed">
            <div class="narrow"><VideoEmbed src="vaja/highlight-720.mp4" poster="vaja/highlight-poster.webp" label={{ en: 'Journey of Vaja gameplay, 51 seconds, no sound' }} loop /></div>
          </Specimen>
          <Specimen name="Stage">
            <Stage src="vaja/object.webp" alt={{ en: 'Vaja, the player character, holding the crystal staff' }} plate="step-right" size="card" cat="game" idx="01" note={{ en: 'Sprite from the game build', th: 'sprite จาก build ของเกม', ja: 'ゲームビルドのスプライト' }}
              callouts={[{ x: 86, y: 9, label: { en: 'Crystal staff', th: 'ไม้เท้าคริสตัล', ja: '水晶の杖' }, sub: { en: 'DRAWN BY HAND', th: 'วาดเอง', ja: '手描き' }, side: 'right', key: true }, { x: 30, y: 30, label: 'Vaja', sub: { en: '20 ANIMATION CLIPS', th: 'ANIMATION 20 CLIP', ja: 'アニメーション20クリップ' }, side: 'left' }]} />
          </Specimen>
          <Specimen name="Plate">
            <div class="plates">
              {(['step-right', 'step-left', 'center', 'wide'] as const).map((s, i) => (
                <figure data-cat={(['game', 'ai', 'hw', 'tool'] as const)[i]}><div class="plate-box"><Plate shape={s} inset="6%" /></div><figcaption class="eyebrow">{s}</figcaption></figure>
              ))}
            </div>
          </Specimen>
          <Specimen name="FrameStepper">
            <FrameStepper strips={[{ src: 'vaja/strip-attack1-padded.webp', frames: 10, name: 'Vaja · attack1', fps: 12, start: 7 }, { src: 'vaja/strip-run.webp', frames: 8, name: 'Vaja · run', fps: 12, start: 2 }, { src: 'vaja/strip-boss-deer-idle.webp', frames: 13, name: 'Crystal deer boss · idle', fps: 12 }]} />
          </Specimen>
          <Specimen name="Figure">
            <Figure n="01" caption={{ en: 'How content becomes this site', th: 'เนื้อหากลายเป็นเว็บนี้ยังไง', ja: 'コンテンツがこのサイトになるまで' }} note={{ en: 'The real pipeline of this repo.', th: 'pipeline จริงของ repo นี้', ja: 'このリポジトリの実際のパイプライン' }}>
              <svg viewBox="0 0 600 190" role="img" aria-label="works yaml and stories mdx are checked by the schema, built by Astro, deployed to GitHub Pages">
                <g class="dg-grid">{Array.from({ length: 30 }, (_, i) => <line x1={i * 20} y1="0" x2={i * 20} y2="190" />)}</g>
                <rect class="dg-box" x="16" y="30" width="136" height="50" /><text class="dg-lbl" x="28" y="52">works/*.yaml</text><text class="dg-sm" x="28" y="68">FACTS · 3 LANGS</text>
                <rect class="dg-box" x="16" y="110" width="136" height="50" /><text class="dg-lbl" x="28" y="132">stories/*.mdx</text><text class="dg-sm" x="28" y="148">COMPOSITION</text>
                <path class="dg-flow" d="M152 55 H214 V95 M152 135 H214 V95 H250" /><path class="dg-dir" d="M152 55 H214 V95 M152 135 H214 V95 H250" />
                <rect class="dg-box core" x="250" y="66" width="130" height="58" /><text class="dg-lbl" x="262" y="90">schema check</text><text class="dg-sm" x="262" y="108">BUILD FAILS IF WRONG</text>
                <path class="dg-wire" d="M380 95 H428" /><path class="dg-arrow" d="M428 90 L438 95 L428 100 Z" />
                <rect class="dg-box" x="440" y="66" width="140" height="58" /><text class="dg-lbl" x="452" y="90">astro build</text><text class="dg-sm" x="452" y="108">→ GITHUB PAGES</text>
              </svg>
            </Figure>
          </Specimen>
          <Specimen name="FlowDiagram">
            <FlowDiagram n="02" caption={{ en: 'How content becomes this site — drawn from data', th: 'เนื้อหากลายเป็นเว็บนี้ยังไง — วาดจากข้อมูล', ja: 'コンテンツがこのサイトになるまで — データから描画' }}
              note={{ en: 'The same real pipeline as the Figure above, written as nodes and edges instead of SVG.', th: 'pipeline จริงเดียวกับ Figure ด้านบน แต่เขียนเป็น node กับ edge แทน SVG', ja: '上のFigureと同じ実際のパイプラインを、SVGではなくノードとエッジで書いたもの。' }}
              nodes={[
                { id: 'y', col: 0, label: 'works/*.yaml', sub: { en: 'FACTS · 3 LANGS', th: 'FACTS · 3 ภาษา', ja: '事実 · 3言語' } },
                { id: 'm', col: 0, label: 'stories/*.mdx', sub: { en: 'COMPOSITION', th: 'COMPOSITION', ja: '構成' } },
                { id: 's', col: 1, label: { en: 'schema check', th: 'schema check', ja: 'スキーマ検査' }, sub: { en: 'BUILD FAILS IF WRONG', th: 'ผิดแล้ว BUILD ไม่ผ่าน', ja: '誤りならビルド失敗' }, core: true },
                { id: 'b', col: 2, label: 'astro build', sub: { en: 'STATIC HTML', th: 'STATIC HTML', ja: '静的HTML' } },
                { id: 'g', col: 3, label: 'GitHub Pages', sub: 'VVEB1250.GITHUB.IO' }
              ]}
              edges={[
                { from: 'y', to: 's', active: true },
                { from: 'm', to: 's', active: true },
                { from: 's', to: 'b', active: true },
                { from: 'b', to: 'g', label: 'GitHub Actions' }
              ]} />
          </Specimen>
          <Specimen name="ScrubFrames" pad={false}>
            <div data-cat="game" class="trace-demo"><ScrubFrames src="vaja/strip-boss-deer-idle.webp" frames={13} name="Crystal deer boss · idle" fps={12} /></div>
          </Specimen>
          <Specimen name="PortraitSwap">
            <div style="max-width:240px"><PortraitSwap items={[
              { src: 'portrait/github-avatar.jpg', alt: { en: 'Web’s GitHub picture: a drawn face, smiling' }, label: 'GitHub · VVeb1250', href: 'https://github.com/VVeb1250' },
              { src: 'portrait/instagram-avatar.webp', alt: { en: 'Web’s Instagram picture: a drawn face, crying' }, label: 'Instagram · web_1250', href: 'https://www.instagram.com/web_1250/' },
              { src: 'portrait/photo-2025.webp', alt: { en: 'Web in a navy shirt, holding a clapperboard that says CoE 34' }, label: { en: 'Photo · 2025' } }
            ]} /></div>
          </Specimen>
          <Specimen name="PhotoCard" pad={false}>
            <p class="sample trace-note">PLACEHOLDER PICTURES — generated gradients in four shapes (portrait, square, wide, tall) until the hobby drawings and photos are chosen. Tap a card.</p>
            <div class="pc-row trace-demo" data-cat="game">
              <PhotoCard src="placeholder/portrait.webp" alt={{ en: 'Placeholder, portrait 3:4' }} caption={{ en: 'Placeholder · portrait' }} meta="3 : 4" tilt={-2} size="sm" />
              <PhotoCard src="placeholder/wide.webp" alt={{ en: 'Placeholder, landscape 7:4' }} caption={{ en: 'Placeholder · landscape' }} meta="7 : 4" tilt={1.5} />
              <PhotoCard src="placeholder/square.webp" alt={{ en: 'Placeholder, square' }} caption={{ en: 'Placeholder · square' }} meta="1 : 1" tilt={-0.8} size="sm" />
              <PhotoCard src="placeholder/tall.webp" alt={{ en: 'Placeholder, tall 7:12' }} caption={{ en: 'Placeholder · tall' }} meta="7 : 12" tilt={2.5} size="sm" />
            </div>
